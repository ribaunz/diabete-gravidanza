#--------------------------------------------------------------------
# Diario glicemie — configurazione
# Copia questo file in `.env` e completa i valori.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://diario.esempio.it/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE (MySQL / MariaDB)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = diario_glicemie
database.default.username = diario
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# EMAIL — serve per i link di accesso (secondo fattore)
#--------------------------------------------------------------------

email.fromEmail = 'diario@esempio.it'
email.fromName = 'Diario glicemie'
email.protocol = 'smtp'
email.SMTPHost = 'smtp.esempio.it'
email.SMTPUser = 'diario@esempio.it'
email.SMTPPass = ''
email.SMTPPort = 587
email.SMTPCrypto = 'tls'

# In sviluppo: niente invio reale, le email finiscono in writable/emails/
# email.disabilitata = true

#--------------------------------------------------------------------
# SICUREZZA
#--------------------------------------------------------------------

# Chiave di 32 byte in esadecimale: generala con `php spark key:generate`
encryption.key =

# Cookie di sessione e "dispositivo ricordato" solo su HTTPS
cookie.secure = true
cookie.samesite = 'Lax'
